# Conceito Stands: redirecionamentos 301 (Apache / hospedagem Locaweb)
# A Vercel ignora este arquivo; ele só vale na Locaweb.

# Página de erro própria (404.html na raiz)
ErrorDocument 404 /404.html

RewriteEngine On

# 1) Domínio antigo (com ou sem www) -> domínio novo, mantendo o caminho
RewriteCond %{HTTP_HOST} ^(www\.)?conceitofeiraseeventos\.com\.br$ [NC]
RewriteRule ^(.*)$ https://conceitostands.com.br/$1 [R=301,L]

# 2) www.conceitostands.com.br -> conceitostands.com.br
RewriteCond %{HTTP_HOST} ^www\.conceitostands\.com\.br$ [NC]
RewriteRule ^(.*)$ https://conceitostands.com.br/$1 [R=301,L]

# 3) http -> https (SSL Let's Encrypt ativo desde 29/10/2026)
# O teste do X-Forwarded-Proto evita loop se a Locaweb terminar o SSL num proxy.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^(.*)$ https://conceitostands.com.br/$1 [R=301,L]

# Tipos MIME corretos: mime.types desatualizado em algumas hospedagens Apache
# (caso da Locaweb) não reconhece estas extensões e serve como octet-stream,
# o que quebra o <video> e o carregamento das fontes.
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType video/webm .webm
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# Compressao de formatos textuais e fontes (WOFF2 já é um formato comprimido,
# o ganho aqui é pequeno, mas não quebra nada).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/ld+json application/xml text/xml image/svg+xml font/woff2 font/woff
</IfModule>

# Cache de 1 ano: CSS e JS já levam ?v= no index.html (cache busting por
# versão), imagens/vídeos/fontes têm nome único por arquivo. HTML nunca entra
# em cache longo (ver mod_headers abaixo), sempre revalidado.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html?|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
